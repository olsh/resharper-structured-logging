using System;
using Serilog;

namespace ConsoleApp
{
    public enum Status
    {
        Active
    }

    public static class Program
    {
        public static void Main(
            int count,
            decimal amount,
            bool enabled,
            char initial,
            Status status,
            Guid orderId,
            DateTime createdAt,
            DateTimeOffset updatedAt,
            TimeSpan elapsed,
            Uri endpoint,
            int? retries)
        {
            Log.Logger.Information("Processed |{@Count}|(0) items for |{@Amount}|(1)", count, amount);
            Log.Logger.Information("Enabled |{@Enabled}|(2) with initial |{@Initial}|(3) and status |{@Status}|(4)", enabled, initial, status);
            Log.Logger.Information("Order |{@OrderId}|(5) created at |{@CreatedAt}|(6), updated at |{@UpdatedAt}|(7)", orderId, createdAt, updatedAt);
            Log.Logger.Information("Took |{@Elapsed}|(8) for |{@Endpoint}|(9) after |{@Retries}|(10) retries", elapsed, endpoint, retries);
        }
    }
}

